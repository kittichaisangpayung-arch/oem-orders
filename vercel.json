{
  "version": 2,
  "builds": [
    {
      "src": "oem_orders/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "oem_orders/wsgi.py"
    }
  ],
  "env": {
    "PIP_REQUIREMENTS": "requirements-production.txt"
  }
}